# =============================================================================
# Bytebot – Docker Environment Configuration
# =============================================================================
# Copy this file to docker/.env and fill in the values you need.
# You only need ONE AI provider to run Bytebot. Pick the free option below.
#
# Usage:
#   cp docker/.env.example docker/.env
#   # Edit docker/.env with your keys
#   docker compose -f docker/docker-compose.yml up -d
# =============================================================================


# =============================================================================
# OPTION A: OpenCode Headless AI Service (Recommended - MIMO v2 Multimodal)
# =============================================================================
OPENCODE_URL=http://opencode:4096
MIMO_API_KEY=your_mimo_api_key_here
MIMO_BASE_URL=https://api.mimo.ai/v1


# -----------------------------------------------------------------------------
# OPTION B: FREE providers via OpenAI-compatible API
# -----------------------------------------------------------------------------
# -- B1: GroqCloud (fast inference) -------------------------------------------
OPENAI_COMPATIBLE_BASE_URL=https://api.groq.com/openai/v1
OPENAI_COMPATIBLE_API_KEY=gsk_your_groq_key_here
OPENAI_COMPATIBLE_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# -- A2: OpenRouter (100+ models, many free-tier options) ----------------------
# Sign up at https://openrouter.ai → Keys → Create Key
# Free models list: https://openrouter.ai/models?q=:free
# Uncomment and replace the lines above with these:
# OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPATIBLE_API_KEY=sk-or-v1-your_openrouter_key_here
# OPENAI_COMPATIBLE_MODELS=meta-llama/llama-3.3-70b-instruct:free,deepseek/deepseek-r1:free

# -- A3: Ollama (fully local, no internet needed) ------------------------------
# Install Ollama: https://ollama.ai → run: ollama pull llama3.2
# Uncomment and replace with:
# OPENAI_COMPATIBLE_BASE_URL=http://host.docker.internal:11434/v1
# OPENAI_COMPATIBLE_API_KEY=ollama
# OPENAI_COMPATIBLE_MODELS=llama3.2,qwen2.5-coder:7b

# -- A4: DeepSeek (low cost) --------------------------------------------------
# Sign up at https://platform.deepseek.com
# OPENAI_COMPATIBLE_BASE_URL=https://api.deepseek.com/v1
# OPENAI_COMPATIBLE_API_KEY=sk-your_deepseek_key_here
# OPENAI_COMPATIBLE_MODELS=deepseek-chat,deepseek-reasoner


# -----------------------------------------------------------------------------
# OPTION B: Paid providers (comment out Option A above if using these)
# -----------------------------------------------------------------------------

# Anthropic Claude (https://console.anthropic.com)
# ANTHROPIC_API_KEY=sk-ant-your_key_here

# OpenAI GPT (https://platform.openai.com/api-keys)
# OPENAI_API_KEY=sk-your_key_here

# Google Gemini (https://aistudio.google.com/app/apikey)
# GEMINI_API_KEY=your_gemini_key_here


# -----------------------------------------------------------------------------
# OPTION C: LiteLLM Proxy (advanced, supports mixing providers)
# Only needed if using docker-compose.proxy.yml
# -----------------------------------------------------------------------------
# BYTEBOT_LLM_PROXY_URL=http://bytebot-llm-proxy:4000

# Groq via LiteLLM proxy
# GROQ_API_KEY=gsk_your_groq_key_here

# OpenRouter via LiteLLM proxy
# OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key_here


# -----------------------------------------------------------------------------
# Resend Email Configuration (Optional - for automated email sending with attachments)
# -----------------------------------------------------------------------------
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_your_resend_api_key_here
# Verified sending domain address or onboarding@resend.dev
RESEND_FROM_EMAIL=onboarding@resend.dev

# -----------------------------------------------------------------------------
# Infrastructure (usually no need to change these)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/bytebotdb
BYTEBOT_DESKTOP_BASE_URL=http://bytebot-desktop:9990
BYTEBOT_AGENT_BASE_URL=http://bytebot-agent:9991
BYTEBOT_DESKTOP_VNC_URL=http://bytebot-desktop:9990/websockify
