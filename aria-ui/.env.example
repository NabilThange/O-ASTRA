# Backend API URL (where aria-agent is running)
ARIA_AGENT_BASE_URL=http://localhost:9991

# Public API URL for Socket.io connections
NEXT_PUBLIC_API_URL=http://localhost:9991

# Desktop VNC WebSocket URL
ARIA_DESKTOP_VNC_URL=ws://localhost:9990/websockify

# Public Desktop VNC URL (for browser access)
NEXT_PUBLIC_DESKTOP_VNC_URL=ws://localhost:9990/websockify

# Groq API Key for Speech-to-Text (STT)
# Get your API key from: https://console.groq.com/keys
# Used for Whisper-based voice transcription in text inputs
# Supports key rotation: GROQ_API_KEY_1, GROQ_API_KEY_2, etc.
GROQ_API_KEY=your_groq_api_key_here

