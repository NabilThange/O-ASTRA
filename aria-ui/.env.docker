# ============================================
# DOCKER DEPLOYMENT ENVIRONMENT (Frontend)
# ============================================
# Use this when running aria-ui IN A DOCKER CONTAINER
# All services communicate via Docker service names

# Backend API (aria-agent container)
ARIA_AGENT_BASE_URL=http://aria-agent:9991
NEXT_PUBLIC_API_URL=http://aria-agent:9991

# Desktop VNC (aria-desktop container)
ARIA_DESKTOP_VNC_URL=ws://aria-desktop:9990/websockify
NEXT_PUBLIC_DESKTOP_VNC_URL=ws://aria-desktop:9990/websockify

# Groq API Key for Speech-to-Text (passed from host environment)
