# ============================================
# CLOUD DEPLOYMENT ENVIRONMENT (Frontend)
# ============================================
# Use this when deploying aria-ui to Vercel
# Backend runs locally with Cloudflare Tunnel

# Backend API (via Cloudflare Tunnel)
# REPLACE WITH YOUR ACTUAL CLOUDFLARE TUNNEL URL FOR BACKEND
ARIA_AGENT_BASE_URL=https://your-backend-tunnel.trycloudflare.com

# Public API URL for Socket.io (same as backend URL)
# REPLACE WITH YOUR ACTUAL CLOUDFLARE TUNNEL URL FOR BACKEND
NEXT_PUBLIC_API_URL=https://your-backend-tunnel.trycloudflare.com

# Desktop VNC (via Cloudflare Tunnel)
# REPLACE WITH YOUR ACTUAL CLOUDFLARE TUNNEL URL FOR DESKTOP
ARIA_DESKTOP_VNC_URL=wss://your-desktop-tunnel.trycloudflare.com/websockify
NEXT_PUBLIC_DESKTOP_VNC_URL=wss://your-desktop-tunnel.trycloudflare.com/websockify

