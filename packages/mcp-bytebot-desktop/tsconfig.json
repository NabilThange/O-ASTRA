{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "typeRoots": ["../../node_modules/@types", "../bytebot-ui/node_modules/@types"],
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"]
}
